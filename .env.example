# Application
NODE_ENV=development
PORT=5001
# In production on Render: set to your Vercel URL (e.g. https://your-app.vercel.app)
CLIENT_URL=http://localhost:5173
API_PREFIX=/api/v1

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai-mystery-room?retryWrites=true&w=majority

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Authentication & Sessions
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
SESSION_SECRET=super_secret_session_key_at_least_32_characters_long

# Media Storage & Zero-Budget AI Image Generation
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_PATH=./uploads
# Optional free token from huggingface.co/settings/tokens (no credit card needed)
HF_TOKEN=
IMAGE_GENERATION_ENABLED=true

# Generation Limits
MAX_SCENARIO_LENGTH=3000
MAX_CONCURRENT_GENERATION_JOBS=3
MAX_GENERATION_RETRIES=1

