# Frontend Environment Configuration (Vercel / Local)
#
# Local development:
# Leave empty to use the built-in Vite development proxy (proxies /api to http://localhost:5001)
#
# Production on Vercel:
# Set to your live Render backend URL (no trailing slash)
# Example: https://ai-mystery-room.onrender.com
VITE_API_BASE_URL=https://your-render-backend.onrender.com

